# Secondary indexes.
#
# Every query below is run twice — once before the index exists and once
# after — with the same expected output both times. An index may change how
# long an answer takes. It may not change the answer.

statement ok
CREATE TABLE t(a INTEGER, b TEXT, c REAL)

statement ok
INSERT INTO t VALUES (1, 'one', 1.5), (2, 'two', 2.5), (3, 'three', -3.5)

statement ok
INSERT INTO t VALUES (4, 'four', 0.0), (5, 'five', 100.25), (6, 'two', -0.5)

statement ok
INSERT INTO t VALUES (-1, 'negative', -1.0), (0, 'zero', 0.5), (7, NULL, NULL)

# --- answers before any index exists ----------------------------------------

query I nosort
SELECT a FROM t WHERE a = 3
----
3

query I nosort
SELECT a FROM t WHERE a = -1
----
-1

query I nosort
SELECT a FROM t WHERE a = 99
----

query I nosort
SELECT a FROM t WHERE a > 4 ORDER BY a
----
5
6
7

query I nosort
SELECT a FROM t WHERE a >= 5 ORDER BY a
----
5
6
7

query I nosort
SELECT a FROM t WHERE a < 1 ORDER BY a
----
-1
0

query I nosort
SELECT a FROM t WHERE a <= 0 ORDER BY a
----
-1
0

query I nosort
SELECT a FROM t WHERE a > 1 AND a < 4 ORDER BY a
----
2
3

query I nosort
SELECT a FROM t WHERE 3 = a
----
3

query I rowsort
SELECT a FROM t WHERE b = 'two'
----
2
6

query I nosort
SELECT a FROM t WHERE c < 0 ORDER BY a
----
-1
3
6

query I nosort
SELECT a FROM t WHERE b IS NULL
----
7

query I nosort
SELECT a FROM t WHERE b = NULL
----

# --- now index everything, and demand identical answers ---------------------

statement ok
CREATE INDEX idx_a ON t(a)

statement ok
CREATE INDEX idx_b ON t(b)

statement ok
CREATE INDEX idx_c ON t(c)

query I nosort
SELECT a FROM t WHERE a = 3
----
3

query I nosort
SELECT a FROM t WHERE a = -1
----
-1

query I nosort
SELECT a FROM t WHERE a = 99
----

query I nosort
SELECT a FROM t WHERE a > 4 ORDER BY a
----
5
6
7

query I nosort
SELECT a FROM t WHERE a >= 5 ORDER BY a
----
5
6
7

query I nosort
SELECT a FROM t WHERE a < 1 ORDER BY a
----
-1
0

query I nosort
SELECT a FROM t WHERE a <= 0 ORDER BY a
----
-1
0

query I nosort
SELECT a FROM t WHERE a > 1 AND a < 4 ORDER BY a
----
2
3

query I nosort
SELECT a FROM t WHERE 3 = a
----
3

query I rowsort
SELECT a FROM t WHERE b = 'two'
----
2
6

query I nosort
SELECT a FROM t WHERE c < 0 ORDER BY a
----
-1
3
6

query I nosort
SELECT a FROM t WHERE b IS NULL
----
7

query I nosort
SELECT a FROM t WHERE b = NULL
----

# --- the index tracks writes ------------------------------------------------

statement ok
INSERT INTO t VALUES (8, 'eight', 8.0)

query I nosort
SELECT a FROM t WHERE a = 8
----
8

statement ok
UPDATE t SET a = 9 WHERE a = 8

query I nosort
SELECT a FROM t WHERE a = 8
----

query I nosort
SELECT a FROM t WHERE a = 9
----
9

statement ok
DELETE FROM t WHERE a = 9

query I nosort
SELECT a FROM t WHERE a = 9
----

# An indexed column updated to a value that already exists in the index.
statement ok
UPDATE t SET b = 'two' WHERE a = 1

query I rowsort
SELECT a FROM t WHERE b = 'two'
----
1
2
6

# --- dropping an index changes nothing but the plan -------------------------

statement ok
DROP INDEX idx_a

query I nosort
SELECT a FROM t WHERE a = 3
----
3

query I nosort
SELECT a FROM t WHERE a > 4 ORDER BY a
----
5
6
7

# --- rejections -------------------------------------------------------------

statement error
CREATE INDEX idx_b ON t(b)

statement ok
CREATE INDEX IF NOT EXISTS idx_b ON t(b)

statement error
CREATE INDEX idx_missing ON t(nosuchcolumn)

statement error
CREATE INDEX idx_missing ON nosuchtable(a)

statement error
DROP INDEX idx_never_existed

statement ok
DROP INDEX IF EXISTS idx_never_existed

#unsupported: composite indexes need a tuple encoding and prefix-aware planning
statement ok
CREATE INDEX idx_ab ON t(a, b)
