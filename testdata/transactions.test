# BEGIN / COMMIT / ROLLBACK over the snapshot-isolation engine from stage 2.

statement ok
CREATE TABLE acct(id INTEGER, balance INTEGER)

statement ok
INSERT INTO acct VALUES (1, 100), (2, 200)

query I nosort
SELECT balance FROM acct ORDER BY id
----
100
200

statement ok
BEGIN

statement ok
UPDATE acct SET balance = 150 WHERE id = 1

# Inside the transaction the change is visible to itself.
query I nosort
SELECT balance FROM acct WHERE id = 1
----
150

statement ok
ROLLBACK

# And gone once it is rolled back.
query I nosort
SELECT balance FROM acct WHERE id = 1
----
100

statement ok
BEGIN

statement ok
UPDATE acct SET balance = 50 WHERE id = 1

statement ok
UPDATE acct SET balance = 250 WHERE id = 2

statement ok
COMMIT

query I nosort
SELECT balance FROM acct ORDER BY id
----
50
250

# A transaction spanning a CREATE and its rows either happens whole or not at all.
statement ok
BEGIN

statement ok
CREATE TABLE temp_t(a INTEGER)

statement ok
INSERT INTO temp_t VALUES (1), (2)

statement ok
ROLLBACK

statement error
SELECT a FROM temp_t

statement ok
BEGIN

statement ok
CREATE TABLE kept(a INTEGER)

statement ok
INSERT INTO kept VALUES (7)

statement ok
COMMIT

query I nosort
SELECT a FROM kept
----
7

statement error
COMMIT

statement error
ROLLBACK

statement ok
BEGIN

statement error
BEGIN

statement ok
ROLLBACK
